{
  "info": {
    "_postman_id": "cf44c611-c48b-42a8-b239-bc0c810711ab",
    "name": "Payroll Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "employee_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth - Register Employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"employee01\",\n  \"password\": \"password123\",\n  \"role\": \"employee\"\n}"
        }
      }
    },
    {
      "name": "Auth - Register Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin01\",\n  \"password\": \"adminpass\",\n  \"role\": \"admin\"\n}"
        }
      }
    },
    {
      "name": "Auth - Login Employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"employee01\",\n  \"password\": \"password123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "pm.environment.set('employee_token', jsonData.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Login Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin01\",\n  \"password\": \"adminpass\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "pm.environment.set('admin_token', jsonData.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin - Create Attendance Period",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/admin/attendance-period",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startDate\": \"2025-07-01\",\n  \"endDate\": \"2025-07-31\"\n}"
        }
      }
    },
    {
      "name": "Employee - Submit Attendance",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employee_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/employee/attendance",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"2025-07-14\"\n}"
        }
      }
    },
    {
      "name": "Employee - Submit Overtime",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employee_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/employee/overtime",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"2025-07-14\",\n  \"hours\": 2\n}"
        }
      }
    },
    {
      "name": "Employee - Submit Reimbursement",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employee_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/employee/reimbursement",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 500000,\n  \"description\": \"Office supplies\"\n}"
        }
      }
    },
    {
      "name": "Admin - Run Payroll",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/admin/run-payroll/1"
      }
    },
    {
      "name": "Employee - Generate Payslip",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employee_token}}"
          }
        ],
        "url": "{{base_url}}/employee/payslip/1"
      }
    },
    {
      "name": "Admin - Generate Payslip Summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": "{{base_url}}/admin/payslip-summary/1"
      }
    }
  ]
}
