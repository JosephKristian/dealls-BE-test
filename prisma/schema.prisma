// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  username  String    @unique
  email     String    @unique
  password  String
  role      String
  salary    Int?
  isDeleted Boolean   @default(false)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime?
  deletedBy String?
  deletedAt DateTime?

  attendances Attendance[]
  overtimes   Overtime[]
  payroll     Payroll[]
}

model AuditLog {
  id          String   @id @default(uuid())
  entity      String
  entityId    String   @map("entity_id")
  action      String
  performedBy String?  @map("performed_by")
  ipAddress   String?  @map("ip_address")
  requestId   String?  @map("request_id")
  timestamp   DateTime @default(now())
  oldData     Json?    @map("old_data")
  newData     Json?    @map("new_data")

  @@map("audit_logs")
}

model Attendance {
  id        String    @id @default(uuid())
  userId    String
  payrollId String?
  user      User      @relation(fields: [userId], references: [id])
  date      DateTime
  isDeleted Boolean   @default(false)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime?
  deletedBy String?
  deletedAt DateTime?
  isLocked  Boolean   @default(false)

  payroll Payroll? @relation(fields: [payrollId], references: [id])

  @@unique([userId, date, isDeleted])
}

model Overtime {
  id        String    @id @default(uuid())
  userId    String
  payrollId String?
  date      DateTime
  hours     Float
  createdBy String?
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime?
  isDeleted Boolean   @default(false)
  deletedBy String?
  deletedAt DateTime?
  isLocked  Boolean   @default(false)

  payroll Payroll? @relation(fields: [payrollId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
}

model Reimbursement {
  id          String   @id @default(cuid())
  userId      String
  payrollId   String?
  amount      Float
  description String
  date        DateTime

  // Audit fields
  createdAt DateTime  @default(now())
  createdBy String
  updatedAt DateTime?
  updatedBy String?
  deletedAt DateTime?
  isLocked  Boolean   @default(false)
  deletedBy String?
  isDeleted Boolean   @default(false)

  payroll Payroll? @relation(fields: [payrollId], references: [id])

  @@index([userId])
}

model Payroll {
  id                 String   @id @default(uuid())
  userId             String
  periodStart        DateTime
  periodEnd          DateTime
  baseSalary         Int
  proratedSalary     Int
  totalPay           Int
  overtimePay        Int
  totalOvertime      Int
  totalReimbursement Int
  takeHomePay        Int
  createdBy          String
  createdAt          DateTime @default(now())
  isDeleted          Boolean  @default(false)
  isLocked           Boolean  @default(false)

  user           User            @relation(fields: [userId], references: [id])
  attendances    Attendance[]
  overtimes      Overtime[]
  reimbursements Reimbursement[]

  @@unique([userId, periodStart, periodEnd])
}
